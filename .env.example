# Copy this file to .env and put your OpenAI key
OPENAI_API_KEY=sk-...

# Agent send_message (optional): an incoming webhook; without one, messages are only logged
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://....webhook.office.com/...
# SEND_MODE=real            # "fake" = decline every proposal (tests)

# Langfuse tracing (optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: password-protect the web app (recommended with --share)
# APP_USERNAME=rudra
# APP_PASSWORD=choose-a-password
